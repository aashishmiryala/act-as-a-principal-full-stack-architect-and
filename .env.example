# ─── AIoT HealthGuard — Environment ─────────────────────────────────────────
# All variables are OPTIONAL. The app runs fully in "simulation" mode with an
# in-browser MQTT broker, ESP32 fleet emulator, ML pipeline and RAG engine when
# no backend is configured. Provide these only to connect a real backend.

# Supabase (optional — enables cloud persistence + auth if present)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Real MQTT broker over WebSockets (optional — otherwise the in-browser broker
# is used). Example: wss://broker.emqx.io:8084/mqtt
VITE_MQTT_WSS_URL=

# LLM endpoint for RAG synthesis (optional — otherwise extractive answers are
# generated locally from retrieved passages).
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
